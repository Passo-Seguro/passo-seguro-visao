{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "0. Verificar ambiente (GPU)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/00_verificar_ambiente.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "1. Importar datasets públicos",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/01_importar_publicos.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "2. Preparar fotos próprias (LGPD)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/02_preparar_fotos_proprias.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "3. Pré-anotar veículos (COCO)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/03_pre_anotar.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "4. Montar dataset 70/20/10 por local",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/04_montar_dataset.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "5a. Treinar baseline (nano, 20 épocas)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/05_treinar.py",
        "--preset",
        "baseline"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "5b. Treinar final nano",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/05_treinar.py",
        "--preset",
        "final",
        "--modelo",
        "n"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "5c. Treinar final small",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/05_treinar.py",
        "--preset",
        "final",
        "--modelo",
        "s"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "6. Avaliar todos no teste (+COCO)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/06_avaliar.py",
        "--todos",
        "--coco"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "7. Análise de erros",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/07_analise_erros.py",
        "--nome",
        "${input:execucao}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "8. Exportar ONNX",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/08_exportar_onnx.py",
        "--nome",
        "${input:execucao}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "9. Latência em CPU (2 threads)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/09_latencia.py",
        "--threads",
        "2"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "10a. Tempo real: webcam",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/10_tempo_real.py",
        "--fonte",
        "0"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "10b. Tempo real: vídeo gravando demo",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/10_tempo_real.py",
        "--fonte",
        "${input:video}",
        "--salvar",
        "resultados/demo.mp4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "LGPD: checar GPS antes de publicar",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/checar_lgpd.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Serviço: subir /deteccoes (porta 8001)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "uvicorn",
        "servico.app:app",
        "--port",
        "8001",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Testes (pytest)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Docker: build da imagem do serviço",
      "type": "shell",
      "command": "docker build -t ghcr.io/passo-seguro/passo-seguro-visao:local .",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "execucao",
      "type": "promptString",
      "description": "Nome da execução (ex.: yolo11n_final_640)",
      "default": "yolo11n_final_640"
    },
    {
      "id": "video",
      "type": "promptString",
      "description": "Caminho do vídeo da caminhada",
      "default": "videos/caminhada.mp4"
    }
  ]
}